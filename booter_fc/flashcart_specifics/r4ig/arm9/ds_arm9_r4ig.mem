MEMORY {
	ewram	: ORIGIN = 0x02000800, LENGTH = 4M - 512k
	dtcm	: ORIGIN = 0x02ff0000, LENGTH = 16K
	itcm	: ORIGIN = 0x01000000, LENGTH = 32K
}